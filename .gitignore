# Node / frontend
node_modules/
apps/web/node_modules/
apps/web/dist/
apps/web/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime artifacts (scripts create these on demand)
.omx/
*.pid
*.log
logs/

# Local agent / editor tooling state. Never publish session logs, audit
# bundles, or personal agent settings.
.omc/
.claude/
.serena/
.deepeval/
.mcp.json
CLAUDE.md
apps/web/.omc/
audit-bundle-*.tgz
audit-out/

# Playwright + screen-quality capture output. These are regenerated by
# the qa-audit* specs and should never be committed (~6 MB per run for
# admin /batch full-page screenshots alone).
apps/web/qa-audit-out/

# Stray typo files (e.g. `> tatus` instead of `git status` from rushed
# shell input). Block them so subsequent `git add .` doesn't silently
# include them.
/tatus

# Build / coverage outputs
dist/
build/
coverage/
playwright-report/
test-results/

# OS / editor
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# Local verification scratch artifacts
.omx-task*-seed.json
