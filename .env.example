# Harness local PoC environment template.
# Copy to `.env` and replace secret placeholders with local values. Do not commit `.env`.

# Python runtime
PYTHON_PATH=/opt/conda/envs/wm_env/bin/python
PYTHON_VERSION=3.11.5
PYTHON_ENV_NAME=wm_env
PYTHON_ENV_PREFIX=/opt/conda/envs/wm_env
# Interpreter pinned by apps/api/harness/core/config.py. PYTHON_PATH must equal this value.
HARNESS_CANONICAL_PYTHON_PATH=/opt/conda/envs/wm_env/bin/python

# Core app/security
APP_ENV=development
# svc-viability-v4 I7 (ADR-019.1) — AI compliance mode toggle.
# Allowed values: live | mock_pass | mock_fail.
# Default (live) calls Azure OpenAI and fails closed on any error.
# mock_pass / mock_fail bypass Azure for PoC verification of downstream gates;
# main.py startup raises RuntimeError if a non-live mode is set with
# APP_ENV=production. First non-live invocation per process emits one
# ai_compliance_mock_used audit_logs row + WARNING log (singleton).
AI_COMPLIANCE_MODE=live
LOG_LEVEL=INFO
JWT_SECRET=replace-with-local-secret
JWT_ACCESS_EXPIRE_SECONDS=3600
JWT_REFRESH_EXPIRE_SECONDS=604800

# Refresh-token HttpOnly cookie controls
AUTH_REFRESH_COOKIE_NAME=harness_refresh_token
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAMESITE=lax
AUTH_REFRESH_COOKIE_PATH=/
AUTH_REFRESH_COOKIE_MAX_AGE_SECONDS=604800

# Database / Redis
DATABASE_URL=postgresql://harness_app:replace-password@localhost:5432/harness
REDIS_URL=redis://localhost:6379/0

# AI / embedding minimum config
AZURE_OPENAI_DEPLOYMENT_NAME=replace-with-deployment
BGE_EMBEDDING_API_URL=https://internal.example/embeddings
# BGE_EMBEDDING_API_KEY=replace-with-internal-bge-key
BGE_EMBEDDING_MODEL=BAAI/bge-m3
BGE_EMBEDDING_DIMENSIONS=1024
BGE_EMBEDDING_BATCH_SIZE=100
BGE_EMBEDDING_TIMEOUT_SECONDS=300
BGE_BATCH_SIZE=16
BGE_RERANK_API_URL=https://internal.example/rerank
# BGE_RERANK_API_KEY=replace-with-internal-bge-rerank-key
BGE_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# Live provider collectors / operator smoke
# Non-production local runs may record SKIPPED provider evidence. Production defaults to strict.
HARNESS_PROVIDER_STRICT=false
# Brokerage Open API base URL (set your provider endpoint)
BROKER_BASE_URL=
BROKER_APP_KEY=
BROKER_APP_SECRET=
BROKER_ACCOUNT_NO=
BROKER_ACCOUNT_PROD_CD=
BROKER_IS_VIRTUAL=false
BROKER_TIMEOUT_SECONDS=10
# Provider-specific read-only endpoint paths and transaction ids (set from your provider docs)
BROKER_TOKEN_PATH=
BROKER_QUOTE_PATH=
BROKER_QUOTE_TR_ID=
BROKER_BALANCE_PATH=
BROKER_BALANCE_TR_ID=
HARNESS_BATCH_BROKER_TICKERS=005930
BROKER_MARKET_CODE=J
DART_API_BASE_URL=https://opendart.fss.or.kr
DART_API_KEY=
DART_TIMEOUT_SECONDS=10
HARNESS_BATCH_DART_CORP_CODES=00126380
HARNESS_BATCH_DART_TARGETS_JSON=
HARNESS_BATCH_DART_LOOKBACK_DAYS=365
HARNESS_BATCH_DART_DISCOVERY_STOCK_CODES=005930,000660,035420,005380,068270
HARNESS_BATCH_DART_PAGE_COUNT=100
ECOS_API_BASE_URL=https://ecos.bok.or.kr/api
ECOS_API_KEY=
ECOS_TIMEOUT_SECONDS=10
ECOS_STATISTIC_CODE=722Y001
ECOS_CYCLE=D
ECOS_INDICATOR_NAME=base_rate
ECOS_UNIT=연%
ECOS_ITEM_CODES=0101000
HARNESS_BATCH_ECOS_LOOKBACK_DAYS=14
HARNESS_BATCH_ECOS_DATE_LAG_DAYS=1
# Preferred multi-target ECOS config. Keep item/date refs secret-free.
HARNESS_BATCH_ECOS_TARGETS_JSON=[{"statistic_code":"722Y001","cycle":"D","indicator_name":"base_rate","unit":"연%","item_codes":["0101000"],"lookback_days":14,"date_lag_days":1},{"statistic_code":"731Y001","cycle":"D","indicator_name":"usd_krw_reference_rate","unit":"원","item_codes":["0000001"],"lookback_days":14,"date_lag_days":1}]
DATA_GO_KR_API_BASE_URL=https://apis.data.go.kr/1160100/service/GetStockSecuritiesInfoService
DATA_GO_KR_SERVICE_KEY_ENCODING=
DATA_GO_KR_SERVICE_KEY_DECODING=
DATA_GO_KR_TIMEOUT_SECONDS=10
DATA_GO_KR_MARKET_PATH=/getStockPriceInfo
DATA_GO_KR_TICKER_FIELD=srtnCd
DATA_GO_KR_DATE_FIELD=basDt
DATA_GO_KR_CLOSE_FIELD=clpr
DATA_GO_KR_OPEN_FIELD=mkp
DATA_GO_KR_HIGH_FIELD=hipr
DATA_GO_KR_LOW_FIELD=lopr
DATA_GO_KR_VOLUME_FIELD=trqu
DATA_GO_KR_NUM_ROWS=10
HARNESS_BATCH_DATA_GO_KR_TARGETS_JSON=[{"path":"/getStockPriceInfo","query":{"numOfRows":5,"likeSrtnCd":"005930"},"ticker_field":"srtnCd","date_field":"basDt","close_field":"clpr","open_field":"mkp","high_field":"hipr","low_field":"lopr","volume_field":"trqu"},{"path":"/getStockPriceInfo","query":{"numOfRows":5,"likeSrtnCd":"000660"},"ticker_field":"srtnCd","date_field":"basDt","close_field":"clpr","open_field":"mkp","high_field":"hipr","low_field":"lopr","volume_field":"trqu"},{"path":"/getStockPriceInfo","query":{"numOfRows":5,"likeSrtnCd":"035420"},"ticker_field":"srtnCd","date_field":"basDt","close_field":"clpr","open_field":"mkp","high_field":"hipr","low_field":"lopr","volume_field":"trqu"},{"path":"/getStockPriceInfo","query":{"numOfRows":5,"likeSrtnCd":"005380"},"ticker_field":"srtnCd","date_field":"basDt","close_field":"clpr","open_field":"mkp","high_field":"hipr","low_field":"lopr","volume_field":"trqu"},{"path":"/getStockPriceInfo","query":{"numOfRows":5,"likeSrtnCd":"068270"},"ticker_field":"srtnCd","date_field":"basDt","close_field":"clpr","open_field":"mkp","high_field":"hipr","low_field":"lopr","volume_field":"trqu"}]
KRX_API_BASE_URL=https://data-dbg.krx.co.kr
KRX_API_KEY=
KRX_API_TIMEOUT_SECONDS=20
KRX_API_RATE_LIMIT_SLEEP_MS=200
HARNESS_BATCH_KRX_ENABLED=false
# Official branch: HARNESS_BATCH_KRX_SOURCE=KRX + OFFICIAL_KRX_APPROVED + KRX_API_KEY.
# Auxiliary branch: HARNESS_BATCH_KRX_SOURCE=PYKRX + PYKRX_AUXILIARY_APPROVED.
HARNESS_BATCH_KRX_SOURCE=KRX
HARNESS_BATCH_KRX_POLICY=OFFICIAL_KRX_APPROVED
HARNESS_BATCH_KRX_MARKETS=KOSPI,KOSDAQ
HARNESS_BATCH_KRX_TICKERS=005930
# Serviceable official-KRX universe mode ignores HARNESS_BATCH_KRX_TICKERS for selection.
HARNESS_BATCH_KRX_UNIVERSE_CODE=DOMESTIC_TOP200_MARKET_CAP
HARNESS_BATCH_KRX_UNIVERSE_SIZE=200
HARNESS_BATCH_KRX_UNIVERSE_MARKETS=KOSPI,KOSDAQ
HARNESS_BATCH_KRX_UNIVERSE_EXCLUDE_PREFERRED=true
HARNESS_BATCH_KRX_MIN_TRADING_DAY_COVERAGE_RATIO=1.0
HARNESS_BATCH_KRX_RESOLVE_AS_OF_TRADING_DAY=true
HARNESS_BATCH_KRX_LOOKBACK_DAYS=30
HARNESS_BATCH_KRX_START_DATE=2026-04-15
HARNESS_BATCH_KRX_END_DATE=2026-05-15

# Batch scheduler controls. The scheduler is opt-in and reuses the same Redis-locking
# runner; serviceable_top200_30d stays disabled unless official KRX governance is complete.
HARNESS_BATCH_SCHEDULER_ENABLED=false
HARNESS_BATCH_RAG_REFRESH_ENABLED=true
HARNESS_BATCH_RAG_REFRESH_INTERVAL_SECONDS=3600
HARNESS_BATCH_DERIVED_REFRESH_ENABLED=true
HARNESS_BATCH_DERIVED_REFRESH_INTERVAL_SECONDS=3600
HARNESS_BATCH_SERVICEABLE_TOP200_SCHEDULER_ENABLED=false
HARNESS_BATCH_SERVICEABLE_TOP200_INTERVAL_SECONDS=86400
HARNESS_BATCH_LOOKBACK_DAYS=30
HARNESS_BATCH_AS_OF_DATE=2026-05-16
HARNESS_PROVIDER_STRICTNESS=required
# Optional JSON list of custom scheduler jobs. Example item:
# [{"name":"custom_rag","stages":["transform","embed"],"interval_seconds":3600}]
HARNESS_BATCH_SCHEDULES_JSON=

# Email send is opt-in and must use real SMTP; disabled paths fail closed without sending.
HARNESS_EMAIL_SEND_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER_EMAIL=
SMTP_SENDER_NAME=Harness
TEST_RECIPIENT_EMAIL=
SMTP_TIMEOUT_SECONDS=10

# Browser-visible values only; never put secrets under VITE_*.
VITE_API_BASE_URL=/api
VITE_WS_BASE_URL=/api/ws

# ---------------------------------------------------------------------------
# Additional keys read by the backend (names only; fill in locally, never commit values)
# ---------------------------------------------------------------------------
# Azure OpenAI (LLM)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_BASE_URL=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_GPT5_DEPLOYMENT=
# Generative RAG lane. When false/unset /ai/rag/qa uses the extractive citation gate only.
AZURE_GENERATIVE_RAG_ENABLED=
# Azure AI Content Safety (optional output guard)
AZURE_CONTENT_SAFETY_ENABLED=
AZURE_CONTENT_SAFETY_ENDPOINT=
AZURE_CONTENT_SAFETY_API_KEY=
AZURE_CONTENT_SAFETY_API_VERSION=
AZURE_CONTENT_SAFETY_THRESHOLD=
AZURE_CONTENT_SAFETY_TIMEOUT_SECONDS=
# Faithfulness / token budget guards
AI_FAITHFULNESS_MIN=
AI_FAITHFULNESS_USE_DEEPEVAL=
AI_TOKEN_CEILING_PER_MIN=
AI_TOKEN_CEILING_PER_HOUR=
AI_TOKEN_CEILING_MONTHLY=
# BGE client extras
BGE_AUTH_SCHEME=
BGE_EMBEDDING_TIMEOUT=
# Env contract for deterministic 1024-dim fixture vectors (services/rag/embedding_config.py).
# Not wired into the batch embed stage; the embed stage always calls the BGE endpoint.
WMAH_USE_SYNTHETIC_EMBEDDINGS=0
# Split DB settings (alternative to DATABASE_URL, used by db/migrator.py)
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# Split Redis / Sentinel settings (alternative to REDIS_URL)
REDIS_HOST=
REDIS_PORT=
REDIS_DB=
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=
REDIS_SOCKET_CONNECT_TIMEOUT=
REDIS_SOCKET_TIMEOUT=
REDIS_SENTINEL_HOSTS=
REDIS_SENTINEL_SERVICE_NAME=
# CORS (disabled by default; same-origin /api via Vite/Nginx proxy)
CORS_ENABLED=false
CORS_ALLOWED_ORIGINS=
# Email transport selection and local Mailpit sink
HARNESS_EMAIL_TRANSPORT=
MAILPIT_HOST=
MAILPIT_PORT=
MAILPIT_SMTP_AUTH_USER=
MAILPIT_SMTP_AUTH_PASSWORD=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
# Optional alternate env file path (tests use an overlay copy of .env)
HARNESS_ENV_FILE=
