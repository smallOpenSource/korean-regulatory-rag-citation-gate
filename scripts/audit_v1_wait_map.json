{
  "_schema": {
    "version": 1,
    "purpose": "Per-route anchor element selectors for BFS auth race mitigation.",
    "rule": "[[bfs-auth-race-window]] — networkidle + 700ms is insufficient on 8/112 cells (Step 1 baseline). After page.goto and login_redirect retry, wait for `window.__wmahAuth?.getAccessToken()` truthy (auth restore complete via refresh cookie) AND for the per-route anchor selector. Wait timeout each: 6000ms.",
    "format": {
      "slug": "from audit_v1_ui_matrix.ROUTES",
      "anchor": "Playwright locator string; first matching element decides page is rendered",
      "fallback": "If anchor selector times out, fall back to `<main>` (always present once Layout renders) before declaring failure"
    },
    "fallback_selector": "main",
    "auth_token_poll_ms": 6000,
    "anchor_poll_ms": 6000
  },
  "routes": {
